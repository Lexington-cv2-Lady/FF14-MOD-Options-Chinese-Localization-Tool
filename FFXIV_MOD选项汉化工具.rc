/////////////////////////////////////////////////////////////////////////////
//
// 图标
//

// ID 值最低的图标放在最前面，以确保应用程序图标
// 在所有系统中保持一致。

IDI_FFXIVMOD       ICON         "FFXIV_MOD选项汉化工具.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// 菜单
//

IDC_FFXIVMOD MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "退出(&X)",                IDM_EXIT
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A) ...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// 快捷键
//

IDC_FFXIVMOD ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// 对话框
//

IDD_FFXIVMOD_DIALOG DIALOGEX 0, 0, 580, 470
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "FFXIV 模组汉化工具"
FONT 11, "MS Shell Dlg"
BEGIN
    GROUPBOX        "目录设置",IDC_GRP_DIR,7,7,566,82
    LTEXT           "Penumbra 父目录（扫描所有模组）:",IDC_STATIC,15,17,165,11
    EDITTEXT        IDC_EDIT_PENUMBRA,185,15,285,15,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览",IDC_BTN_BROWSE_PENUMBRA,478,14,46,16
    PUSHBUTTON      "打开",IDC_BTN_OPEN_PENUMBRA,528,14,44,16
    LTEXT           "翻译目录:",IDC_STATIC,15,37,165,11
    EDITTEXT        IDC_EDIT_TRANSLATION,185,35,285,15,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览",IDC_BTN_BROWSE_TRANS,478,34,46,16
    PUSHBUTTON      "打开",IDC_BTN_OPEN_TRANS,528,34,44,16
    LTEXT           "词典目录:",IDC_STATIC,15,57,165,11
    EDITTEXT        IDC_EDIT_DICTIONARY,185,55,285,15,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览",IDC_BTN_BROWSE_DICT,478,54,46,16
    PUSHBUTTON      "打开",IDC_BTN_OPEN_DICT,528,54,44,16

    GROUPBOX        "应用设置",IDC_GRP_APP,7,89,566,56
    AUTORADIOBUTTON "纯中文（去掉英文括号）",IDC_RADIO_PURE_CN,15,102,150,11,WS_GROUP
    AUTORADIOBUTTON "中文（英文）对照",IDC_RADIO_CN_EN,165,102,120,11
    AUTOCHECKBOX    "词序调换（中文（英文）在前）",IDC_CHK_SWAP,300,102,160,11
    AUTOCHECKBOX    "自动备份（提取/应用前打包 zip）",IDC_CHK_BACKUP,15,124,200,11
    LTEXT           "字体大小:",IDC_STATIC,225,124,45,11
    EDITTEXT        IDC_EDIT_FONT_SIZE,270,122,35,15,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "应用",IDC_BTN_APPLY_FONT,310,121,45,16
    AUTOCHECKBOX    "联动字体",IDC_CHK_AUTO_FONT,360,124,70,11

    GROUPBOX        "AI 翻译设置",IDC_GRP_AI,7,145,566,96
    LTEXT           "API Key（OpenAI 兼容接口）:",IDC_STATIC,15,158,165,11
    EDITTEXT        IDC_AI_KEY,185,154,265,15,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "显示",IDC_BTN_SHOW_KEY,458,153,46,16
    LTEXT           "模型名（如 deepseek-v4）:",IDC_STATIC,15,179,165,11
    COMBOBOX        IDC_AI_MODEL,185,175,265,90,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "API 地址（OpenAI 兼容）:",IDC_STATIC,15,200,165,11
    COMBOBOX        IDC_AI_BASEURL,185,196,265,90,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "每批条数(1-100，默认40):",IDC_STATIC,15,221,165,11
    EDITTEXT        IDC_AI_BATCH,185,217,50,15,ES_AUTOHSCROLL
    LTEXT           "越小越稳（Key 存本地 config.json）",IDC_STATIC,240,219,175,11
    PUSHBUTTON      "AI 翻译",IDC_BTN_AI_TRANSLATE,458,215,110,22

    GROUPBOX        "操作",IDC_GRP_OP,7,241,566,108
    PUSHBUTTON      "1. 提取英文",IDC_BTN_EXTRACT,10,256,120,22
    PUSHBUTTON      "2. 导入翻译",IDC_BTN_IMPORT,140,256,120,22
    PUSHBUTTON      "3. 应用翻译",IDC_BTN_APPLY,270,256,120,22
    PUSHBUTTON      "4. 恢复备份",IDC_BTN_RESTORE,400,256,120,22
    PUSHBUTTON      "单词黑名单",IDC_BTN_BLACKLIST,10,284,120,22
    PUSHBUTTON      "Wiki 导出",IDC_BTN_WIKI,140,284,120,22
    PUSHBUTTON      "中断",IDC_BTN_CANCEL,270,284,120,22
    CONTROL         "",IDC_PROGRESS,"msctls_progress32",WS_BORDER | PBS_MARQUEE,15,316,552,12
    LTEXT           "流程：提取英文 → AI/外部翻译 → 导入翻译 → 应用翻译（『4 恢复备份』可撤销）",IDC_STATIC,15,330,552,12
    LTEXT           "辅助：Wiki 导出 / 导入翻译（翻译前补充术语）",IDC_STATIC,15,344,552,12
    GROUPBOX        "日志",IDC_GRP_LOG,7,356,566,114
    CONTROL         "",IDC_LOG_EDIT,"RichEdit20W",WS_BORDER | WS_VSCROLL | WS_TABSTOP | ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY,15,368,552,102
END

IDD_RESTORE_DIALOG DIALOGEX 0, 0, 460, 360
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "恢复备份"
FONT 9, "MS Shell Dlg"
BEGIN
    GROUPBOX        "模组文件夹（点击即勾选，Ctrl+A 全选）",IDC_STATIC,7,7,220,310
    CONTROL         "",IDC_RESTORE_LEFTLIST,"SysListView32",LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SHOWSELALWAYS | WS_BORDER | WS_VSCROLL | WS_TABSTOP,15,20,204,285
    GROUPBOX        "备份包（可多选）",IDC_STATIC,233,7,220,310
    LISTBOX         IDC_RESTORE_RIGHTLIST,241,20,204,285,LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "恢复选中",IDC_RESTORE_BTN,150,323,75,14
    PUSHBUTTON      "关闭",IDC_RESTORE_CLOSE,260,323,50,14
END

IDD_BLACKLIST_DIALOG DIALOGEX 0, 0, 320, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "单词黑名单"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "每行一个单词或用逗号间隔（如 rue,small）。黑名单词：提取时跳过、应用时跳过、已应用的自动还原为英文。保存到翻译目录的 单词黑名单.json。",IDC_STATIC,7,7,306,38
    EDITTEXT        IDC_BLACKLIST_EDIT,7,50,306,140,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "确定",IDC_BLACKLIST_OK,115,198,50,14
    PUSHBUTTON      "取消",IDC_BLACKLIST_CANCEL,175,198,50,14
END

IDD_WIKI_CATS_DIALOG DIALOGEX 0, 0, 360, 340
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择 Wiki 导出分类"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "单击行即勾选（复选框），Ctrl+A 或点「全选」可一次框选全部。",IDC_STATIC,7,7,346,12
    CONTROL         "",IDC_WIKI_CATS_LIST,"SysListView32",LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SHOWSELALWAYS | WS_BORDER | WS_VSCROLL | WS_TABSTOP,7,22,346,260
    PUSHBUTTON      "全选",IDC_WIKI_CATS_ALL,100,292,50,14
    PUSHBUTTON      "取消全选",IDC_WIKI_CATS_NONE,160,292,60,14
    DEFPUSHBUTTON   "确定",IDC_WIKI_CATS_OK,230,292,50,14
    PUSHBUTTON      "取消",IDC_WIKI_CATS_CANCEL,290,292,50,14
END

IDD_IMPORT_TRANS_DIALOG DIALOGEX 0, 0, 420, 242
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "导入翻译"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "选择要导入的翻译文件（AI 或人工翻译好的 *_已翻译.json / *_未翻译.json）：",IDC_STATIC,7,7,406,12
    LISTBOX         IDC_IMPORT_LIST,7,22,406,140,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY
    AUTOCHECKBOX    "导入前用词典自动补全未翻译项（唯一词典）",IDC_IMPORT_AUTOFILL,7,168,406,12
    LTEXT           "功能一：用词典补全空白项 → 生成/更新 *_已翻译.json（不覆盖已有翻译）。",IDC_STATIC,7,184,406,12
    LTEXT           "功能二：将该文件所有非空翻译编入 唯一词典 wiki_术语对照and个人填充.json（已有不覆盖）。",IDC_STATIC,7,198,406,12
    DEFPUSHBUTTON   "确定",IDC_IMPORT_OK,265,220,60,14
    PUSHBUTTON      "取消",IDC_IMPORT_CANCEL,335,220,60,14
END

